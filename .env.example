
# BioEvidence public configuration template
# Copy this file to .env locally and replace placeholders as needed.
# Never commit your real .env file or actual credentials.

# PostgreSQL
PG_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql://app:CHANGE_ME_LOCAL_POSTGRES_PASSWORD@postgres:5432/biomed_evidence

# Neo4j
NEO4J_PASSWORD=CHANGE_ME_LOCAL_NEO4J_PASSWORD
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# External API credentials (optional unless required by your workflow)
NCBI_API_KEY=YOUR_NCBI_API_KEY_HERE
LLM_API_KEY=YOUR_LLM_API_KEY_HERE

# LLM model configuration
LLM_EXTRACTION_MODEL=claude-sonnet-4-6
LLM_CLASSIFIER_MODEL=claude-sonnet-4-6
LLM_FAILURE_PIPELINE_MODEL=claude-sonnet-4-6

# Worker
WORKER_POLL_INTERVAL_SECONDS=5

# Cache and local-store directories
NCBI_CACHE_DIR=/tmp/ncbi_cache
CHEMBL_CACHE_DIR=/tmp/chembl_cache
CTGOV_CACHE_DIR=/tmp/ctgov_cache
ENSEMBL_CACHE_DIR=/tmp/ensembl_cache
EUROPEPMC_CACHE_DIR=/tmp/europepmc_cache
OPENTARGETS_CACHE_DIR=/tmp/opentargets_cache
ORPHANET_STORE_DIR=/tmp/orphanet_store
REACTOME_CACHE_DIR=/tmp/reactome_cache
UNIPROT_CACHE_DIR=/tmp/uniprot_cache
