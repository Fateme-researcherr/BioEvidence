# --- docker-compose.yml host-side substitutions ---
# Used by: postgres service (POSTGRES_PASSWORD=${PG_PASSWORD})
PG_PASSWORD=changeme

# Used by: neo4j service (NEO4J_AUTH=neo4j/${NEO4J_PASSWORD})
NEO4J_PASSWORD=changeme

# Used by: api, worker services (NCBI_API_KEY=${NCBI_API_KEY})
# Also read directly by backend/clients/ncbi_client.py
NCBI_API_KEY=changeme

# Used by: api, worker services (LLM_API_KEY=${LLM_API_KEY})
LLM_API_KEY=changeme

# --- Read directly by backend code (os.environ / os.getenv) ---

# backend/api/main.py, backend/orchestration/worker.py
DATABASE_URL=postgresql://app:changeme@postgres:5432/biomed_evidence

# backend/agents/ingestion_curation_agent.py
# backend/orchestration/gap_rules.py
# backend/reasoning/kg_traversal.py
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# backend/orchestration/worker.py
WORKER_POLL_INTERVAL_SECONDS=5

# backend/pipeline/claim_extraction_pipeline.py
LLM_EXTRACTION_MODEL=claude-sonnet-4-6

# backend/reasoning/framework_classifier.py
LLM_CLASSIFIER_MODEL=claude-sonnet-4-6

# backend/reasoning/failure_pipeline.py
LLM_FAILURE_PIPELINE_MODEL=claude-sonnet-4-6

# backend/clients/ncbi_client.py
NCBI_CACHE_DIR=/tmp/ncbi_cache

# backend/clients/chembl_client.py
CHEMBL_CACHE_DIR=/tmp/chembl_cache

# backend/clients/ctgov_client.py
CTGOV_CACHE_DIR=/tmp/ctgov_cache

# backend/clients/ensembl_client.py
ENSEMBL_CACHE_DIR=/tmp/ensembl_cache

# backend/clients/europepmc_client.py
EUROPEPMC_CACHE_DIR=/tmp/europepmc_cache

# backend/clients/opentargets_client.py
OPENTARGETS_CACHE_DIR=/tmp/opentargets_cache

# backend/clients/orphanet_client.py
ORPHANET_STORE_DIR=/tmp/orphanet_store

# backend/clients/reactome_client.py
REACTOME_CACHE_DIR=/tmp/reactome_cache

# backend/clients/uniprot_client.py
UNIPROT_CACHE_DIR=/tmp/uniprot_cache
